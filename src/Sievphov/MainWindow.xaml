<Window x:Class="Sievphov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sievphov – សៀវភៅ" Width="1250" Height="740" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        FontFamily="Segoe UI, Khmer UI, Leelawadee UI">
    <Window.Resources>
        <Style TargetType="Button" x:Key="Tool">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Row 1: adding files and the list -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,6,6,4">
            <WrapPanel x:Name="FileBar">
                <Button Style="{StaticResource Tool}" Content="+ Files" Click="AddFiles_Click" ToolTip="Add PDF files (or drag them onto the list)" />
                <Button Style="{StaticResource Tool}" Content="+ Folder" Click="AddFolder_Click" ToolTip="Add all PDF files in a folder" />
                <Button Style="{StaticResource Tool}" Content="Remove" Click="Remove_Click" ToolTip="Remove selected files from the list (Delete)" />
                <Button Style="{StaticResource Tool}" Content="Clear" Click="Clear_Click" ToolTip="Empty the list" />
                <Button Style="{StaticResource Tool}" Content="Remove printed" Click="RemovePrinted_Click" />
                <Button Style="{StaticResource Tool}" Content="▲" Click="Up_Click" ToolTip="Move up" />
                <Button Style="{StaticResource Tool}" Content="▼" Click="Down_Click" ToolTip="Move down" />
                <Button Style="{StaticResource Tool}" Content="Open folder" Click="OpenFolder_Click" ToolTip="Show the file in Explorer" />
                <Separator Margin="4,0" />
                <Button Style="{StaticResource Tool}" Content="Open job…" Click="OpenJob_Click" ToolTip="Open a saved list (.svpv)  Ctrl+O" />
                <Button Style="{StaticResource Tool}" Content="Save job…" Click="SaveJob_Click" ToolTip="Save the list with every file's settings (.svpv)  Ctrl+S" />
                <Button Style="{StaticResource Tool}" Content="More ▾" Click="More_Click" x:Name="MoreButton">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Save job as…" Click="SaveJobAs_Click" />
                            <MenuItem Header="Saved passwords for locked PDFs…" Click="Passwords_Click" />
                            <MenuItem Header="Open .svpv files with Sievphov (double-click)" Click="Associate_Click" />
                            <MenuItem Header="Open settings folder" Click="SettingsFolder_Click" />
                            <Separator />
                            <MenuItem Header="About Sievphov" Click="About_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Row 2: presets -->
        <Border DockPanel.Dock="Top" Background="#F4F8FF" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6">
            <WrapPanel x:Name="PresetBar">
                <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                <ComboBox x:Name="PresetBox" Width="300" Margin="0,0,4,0" DisplayMemberPath="Name" VerticalContentAlignment="Center" />
                <Button Style="{StaticResource Tool}" Content="Apply to selected" Click="ApplyPreset_Click" FontWeight="SemiBold"
                        ToolTip="Give the selected files this preset's settings (Ctrl+1 … Ctrl+9 for the first 9 presets)" />
                <Button Style="{StaticResource Tool}" Content="Manage presets…" Click="ManagePresets_Click" />
                <Separator Margin="6,0" />
                <Button Style="{StaticResource Tool}" Content="File settings…" Click="FileSettings_Click" ToolTip="Settings of the selected file(s)  Enter / double-click" />
                <Button Style="{StaticResource Tool}" Content="Preview" Click="Preview_Click" ToolTip="See each sheet before printing" />
                <Button Style="{StaticResource Tool}" Content="Estimate" Click="Estimate_Click" ToolTip="Pages and paper needed, per printer" />
            </WrapPanel>
        </Border>

        <!-- Bottom: summary, after printing, progress, buttons -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="280" />
                    <TextBlock Text="After printing:" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <ComboBox x:Name="AfterPrintBox" Width="110" SelectionChanged="AfterPrint_Changed">
                        <ComboBoxItem Content="Do nothing" />
                        <ComboBoxItem Content="Move to" />
                        <ComboBoxItem Content="Copy to" />
                    </ComboBox>
                    <TextBox x:Name="AfterPrintFolderBox" Width="220" Margin="4,0" VerticalContentAlignment="Center" LostFocus="AfterPrintFolder_LostFocus" />
                    <Button Content="…" Width="28" Click="AfterPrintBrowse_Click" x:Name="AfterPrintBrowse" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PauseButton" Content="Pause" Padding="12,4" Margin="0,0,6,0" IsEnabled="False" Click="Pause_Click" />
                    <Button x:Name="StopButton" Content="■ Stop" Padding="12,4" Margin="0,0,6,0" IsEnabled="False" Click="Stop_Click" />
                    <Button x:Name="PrintButton" Content="▶ PRINT" Padding="20,4" FontWeight="Bold" FontSize="14" Click="Print_Click"
                            Background="#2E7D32" Foreground="White" ToolTip="Print all ticked files  Ctrl+P" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <ProgressBar x:Name="Progress" Height="20" Minimum="0" Maximum="1" />
                    <TextBlock x:Name="ProgressText" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- The file list -->
        <Grid>
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="All" RowHeaderWidth="36"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE" AlternatingRowBackground="#FAFAFA"
                      AllowDrop="True" MouseDoubleClick="Grid_MouseDoubleClick" ContextMenuOpening="Grid_ContextMenuOpening"
                      LoadingRow="Grid_LoadingRow" Sorting="Grid_Sorting" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="✓" Width="32" SortMemberPath="IsChecked">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          ToolTip="Tick = print this file" Click="Check_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="File name" Binding="{Binding FileName}" Width="2*" />
                    <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}" Width="55" />
                    <DataGridTextColumn Header="Preset" Binding="{Binding PresetDisplay}" Width="1.5*" />
                    <DataGridTextColumn Header="Printer" Binding="{Binding PrinterDisplay}" Width="1.3*" />
                    <DataGridTextColumn Header="Tray" Binding="{Binding TrayDisplay}" Width="*" />
                    <DataGridTextColumn Header="Paper" Binding="{Binding PaperDisplay}" Width="0.8*" />
                    <DataGridTextColumn Header="Sides" Binding="{Binding SidesDisplay}" Width="0.9*" />
                    <DataGridTextColumn Header="Copies" Binding="{Binding Copies}" Width="55" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding StatusText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter Property="Foreground" Value="#C62828" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Locked">
                                        <Setter Property="Foreground" Value="#C62828" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Printed">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Printing">
                                        <Setter Property="Foreground" Value="#1565C0" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding FilePath}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="File settings…" InputGestureText="Enter" Click="FileSettings_Click" FontWeight="SemiBold" />
                        <MenuItem x:Name="ApplyPresetMenu" Header="Apply preset" />
                        <MenuItem Header="Save as preset…" Click="SaveAsPreset_Click" />
                        <MenuItem Header="Reset to preset" Click="ResetToPreset_Click" />
                        <Separator />
                        <MenuItem Header="Copy settings" InputGestureText="Ctrl+Shift+C" Click="CopySettings_Click" />
                        <MenuItem x:Name="PasteMenu" Header="Paste settings" InputGestureText="Ctrl+Shift+V" Click="PasteSettings_Click" />
                        <Separator />
                        <MenuItem Header="Tick selected" Click="TickSelected_Click" />
                        <MenuItem Header="Untick selected" Click="UntickSelected_Click" />
                        <MenuItem Header="Preview" Click="Preview_Click" />
                        <MenuItem Header="Open containing folder" Click="OpenFolder_Click" />
                        <MenuItem Header="Remove from list" InputGestureText="Del" Click="Remove_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" FontSize="16"
                       TextAlignment="Center" IsHitTestVisible="False"
                       Text="Drag PDF files or folders here&#x0a;or use + Files / + Folder" />
        </Grid>
    </DockPanel>
</Window>
