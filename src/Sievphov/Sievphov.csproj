<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the app be built on Linux/macOS too (it still only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Sievphov</AssemblyName>
    <RootNamespace>Sievphov</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.32" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sievphov.Core\Sievphov.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Symbol files are not needed by users (SkiaSharp alone ships an 89 MB one). -->
  <Target Name="RemoveSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_SymbolsInPublish Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_SymbolsInPublish)" />
  </Target>

</Project>
