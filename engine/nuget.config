<?xml version="1.0" encoding="utf-8"?>
<!-- Where the engine's packages (PDFtoImage, System.Drawing.Common, the .NET runtime packs for the
     self-contained exe) come from. Set here so the build does not depend on each PC's own NuGet setup:
     a fresh .NET SDK install can end up with no package source at all (error NU1100 "Unable to resolve"). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
