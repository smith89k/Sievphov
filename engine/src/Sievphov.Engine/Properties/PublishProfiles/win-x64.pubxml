<?xml version="1.0" encoding="utf-8"?>
<!-- One self-contained Sievphov.Engine.exe for 64-bit Windows: dotnet publish src/Sievphov.Engine -p:PublishProfile=win-x64 (lands in engine-dist/, which electron-builder packs) -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>..\..\..\engine-dist\</PublishDir>
  </PropertyGroup>
</Project>
