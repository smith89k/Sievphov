{
  "name": "sievphov",
  "productName": "Sievphov",
  "version": "2.3.1",
  "description": "Sievphov (សៀវភៅ) — print many PDF files in one go, each with its own printer, tray and settings",
  "main": "main.js",
  "author": "Sunnguon Taing",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js && node scripts/build-engine.js --if-needed --no-test --warn",
    "start": "node scripts/build-engine.js --if-needed --no-test && electron .",
    "engine": "node scripts/build-engine.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:ui": "electron tests/ui/run.js",
    "icons": "electron scripts/make-icons.js",
    "dist": "node scripts/check-notes.js && node scripts/build-engine.js && electron-builder --win nsis --publish never",
    "dist:portable": "node scripts/check-notes.js && node scripts/build-engine.js && electron-builder --win portable --publish never",
    "dist:store": "node scripts/check-notes.js && node scripts/build-engine.js && electron-builder --win appx --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kh.sievphov.app",
    "productName": "Sievphov",
    "copyright": "© 2026 smith89k",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "engine.js",
      "sample-pdf.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine-dist",
        "to": "engine",
        "filter": [
          "Sievphov.Engine.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Sievphov-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sievphov",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Sievphov-Portable-${version}.${ext}"
    },
    "appx": {
      "artifactName": "Sievphov-Store-${version}.${ext}",
      "applicationId": "Sievphov",
      "displayName": "Sievphov",
      "identityName": "smith89k.Sievphov",
      "publisher": "CN=AAA3A883-09DC-4D02-89C9-CD2286F692F0",
      "publisherDisplayName": "Taing Sunnguon",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    },
    "fileAssociations": [
      {
        "ext": "svpv",
        "name": "Sievphov print job",
        "description": "Sievphov print job",
        "role": "Editor",
        "icon": "build/svpv-file.ico"
      }
    ]
  }
}
